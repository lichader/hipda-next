# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

# Two trailing spaces are Markdown line breaks (used in README.md).
[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
